# Copy to .env (gitignored). scripts/db-setup.ps1 writes a real .env for you.
# Never commit .env. It holds database passwords.
#
# Runtime connection: role smartstore_app. DML only; it cannot UPDATE or DELETE append-only tables (ADR-11, ADR-31 s6).
DATABASE_URL=postgres://smartstore_app:CHANGE_ME@localhost:5432/smartstore_dev?sslmode=disable
# Migration connection: role smartstore_owner. Owns the schema, runs dbmate, creates test databases (ADR-31 s6).
MIGRATION_DATABASE_URL=postgres://smartstore_owner:CHANGE_ME@localhost:5432/smartstore_dev?sslmode=disable
