# Copy to .env (gitignored). scripts/db-setup.ps1 writes a real .env for you.
# Never commit .env. It holds database passwords.
#
# Runtime connection: role smartstore_app. DML only; it cannot UPDATE or DELETE append-only tables (ADR-11, ADR-31 s6).
DATABASE_URL=postgres://smartstore_app:CHANGE_ME@localhost:5432/smartstore_dev?sslmode=disable
# Migration connection: role smartstore_owner. Owns the schema, runs dbmate, creates test databases (ADR-31 s6).
MIGRATION_DATABASE_URL=postgres://smartstore_owner:CHANGE_ME@localhost:5432/smartstore_dev?sslmode=disable
#
# Security policy the specification does not state (OPEN-QUESTIONS.md OQ-027). Required, with no defaults: the server
# refuses to start until the owner sets all five. Whole numbers.
# How long a session lasts after sign-in, in minutes.
SESSION_LIFETIME_MINUTES=15
# Failed sign-ins on one login, within the window below, after which that login is refused until the window passes.
SIGN_IN_FAILURE_LIMIT=4
SIGN_IN_FAILURE_WINDOW_MINUTES=2
# How long a price quoted at a scan stays valid for the sale (RT-124); an older cart must be rescanned.
QUOTE_MAX_AGE_MINUTES=5
# How long, in milliseconds, a sale or adjustment waits for a stock balance another till holds (IV-23).
LOCK_TIMEOUT_MS=5000
